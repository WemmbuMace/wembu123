# ---- Minecraft connection ----
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=ClaudeBot
# 'offline' = plain username (needs online-mode=false on the server). 'microsoft' = real account.
MC_AUTH=offline
# Leave blank to auto-detect from the server. Pin only if auto-detect fails, e.g. 1.21.11
MC_VERSION=

# ---- Who the bot obeys ----
# Only listen to this player (leave blank = obey any player).
BOT_OWNER=
# Only react to messages starting with this text, e.g. "bot " (leave blank = react to all chat).
CHAT_PREFIX=
# Words that trigger an instant stop (comma-separated).
STOP_WORDS=stop,стоп,хватит,отмена,cancel

# ---- Brain (Claude Agent SDK) ----
# 'haiku' = latest Haiku (cheap/fast). Pin with claude-haiku-4-5 if you want a fixed snapshot.
MODEL=haiku
MAX_TURNS=40
VERBOSE=false

# Auth for the Claude Agent SDK: it reuses your Claude Code / Claude login if present.
# Otherwise set an API key here (uncomment):
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Behaviour ----
RECONNECT_DELAY_MS=5000
